{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 430,
  "title": {
    "text": "Largest regional medication increases",
    "subtitle": "Peak respiratory medication prescription rate increase vs 2018-19",
    "anchor": "start",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "subtitleColor": "#b8bdc6",
    "color": "#fffaf0"
  },
  "data": {"url": "data/health_sa4_peak.csv"},
  "transform": [
    {"filter": "datum.indicator == 'Respiratory medication prescriptions'"},
    {"window": [{"op": "rank", "as": "rank"}], "sort": [{"field": "max_change_vs_2018_19", "order": "descending"}]},
    {"filter": "datum.rank <= 15"}
  ],
  "mark": {"type": "bar", "color": "#2f6f73"},
  "encoding": {
    "x": {"field": "max_change_vs_2018_19", "type": "quantitative", "title": "Peak ASR increase vs 2018-19"},
    "y": {"field": "sa4_name", "type": "nominal", "sort": "-x", "title": "SA4 area"},
    "tooltip": [
      {"field": "state", "type": "nominal"},
      {"field": "sa4_name", "type": "nominal"},
      {"field": "max_change_vs_2018_19", "type": "quantitative", "format": ".1f"}
    ]
  }
}
